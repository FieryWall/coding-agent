200|export async function getContributors(from: string, to: string) {
201|  const fromRef = from.startsWith("v") ? from : `v${from}`
202|  const toRef = to === "HEAD" ? to : to.startsWith("v") ? to : `v${to}`
203|  const compare =
204|    await $`gh api "/repos/anomalyco/opencode/compare/${fromRef}...${toRef}" --jq '.commits[] | {login: .author.login, message: .commit.message}'`.text()
205|  const contributors = new Map<string, Set<string>>()
206|
207|  for (const line of compare.split("\n").filter(Boolean)) {
208|    const { login, message } = JSON.parse(line) as { login: string | null; message: string }
209|    const title = message.split("\n")[0] ?? ""
