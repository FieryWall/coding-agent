167|export async function generateChangelog(commits: Commit[], opencode: Awaited<ReturnType<typeof createOpencode>>) {
168|  // Summarize commits in parallel with max 10 concurrent requests
169|  const BATCH_SIZE = 10
170|  const summaries: string[] = []
171|  for (let i = 0; i < commits.length; i += BATCH_SIZE) {
172|    const batch = commits.slice(i, i + BATCH_SIZE)
173|    const results = await Promise.all(batch.map((c) => summarizeCommitMessage(opencode, c.message)))
174|    summaries.push(...results)
175|  }
176|
177|  const grouped = new Map<string, string[]>()
178|  for (let i = 0; i < commits.length; i++) {
179|    const commit = commits[i]!
180|    const section = getSection(commit.areas)
181|    const attribution = commit.author && !Script.team.includes(commit.author) ? ` (@${commit.author})` : ""
182|    const entry = `- ${summaries[i]}${attribution}`
183|
184|    if (!grouped.has(section)) grouped.set(section, [])
185|    grouped.get(section)!.push(entry)
186|  }
187|
188|  const sectionOrder = ["Core", "TUI", "Desktop", "SDK", "Extensions"]
189|  const lines: string[] = []
190|  for (const section of sectionOrder) {
191|    const entries = grouped.get(section)
192|    if (!entries || entries.length === 0) continue
193|    lines.push(`## ${section}`)
194|    lines.push(...entries)
195|  }
196|
197|  return lines
198|}
