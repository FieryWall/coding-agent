71|      if (file.startsWith("packages/opencode/src/cli/cmd/")) areas.add("tui")
72|      else if (file.startsWith("packages/opencode/")) areas.add("core")
73|      else if (file.startsWith("packages/desktop/src-tauri/")) areas.add("tauri")
74|      else if (file.startsWith("packages/desktop/")) areas.add("app")
