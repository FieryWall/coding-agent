96|function filterRevertedCommits(commits: Commit[]): Commit[] {
97|  const revertPattern = /^Revert "(.+)"$/
98|  const seen = new Map<string, Commit>()
99|
100|  for (const commit of commits) {
101|    const match = commit.message.match(revertPattern)
102|    if (match) {
103|      // It's a revert - remove the original if we've seen it
104|      const original = match[1]!
105|      if (seen.has(original)) seen.delete(original)
106|      else seen.set(commit.message, commit) // Keep revert if original not in range
107|    } else {
108|      // Regular commit - remove if its revert exists, otherwise add
109|      const revertMsg = `Revert "${commit.message}"`
110|      if (seen.has(revertMsg)) seen.delete(revertMsg)
111|      else seen.set(commit.message, commit)
112|    }
113|  }
114|
115|  return [...seen.values()]
116|}
