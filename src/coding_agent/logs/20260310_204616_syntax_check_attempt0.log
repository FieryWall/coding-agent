130|function getSection(areas: Set<string>): string {
131|  // Priority order for multi-area commits
132|  const priority = ["core", "tui", "app", "tauri", "sdk", "plugin", "extensions/zed", "extensions/vscode", "github"]
133|  for (const area of priority) {
134|    if (areas.has(area)) return sections[area as keyof typeof sections]
135|  }
